{
  "name": "@alessai/mybrowser-mcp",
  "version": "1.1.6",
  "description": "MCP server for MyBrowser - remote browser automation over Tailscale",
  "type": "module",
  "homepage": "https://github.com/alessai/MyBrowser-MCP",
  "bugs": {
    "url": "https://github.com/alessai/MyBrowser-MCP/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alessai/MyBrowser-MCP.git"
  },
  "bin": {
    "mybrowser-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup src/index.ts --format esm --dts && node -e \"require('node:fs').chmodSync('dist/index.js',0o755)\"",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "prepack": "npm run clean && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.1.0",
    "ws": "^8.21.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "3.2.7"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "vite": "6.4.3"
  }
}
